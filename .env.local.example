# Solana network: devnet or mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Sponsor wallet private key (base58 encoded) — NEVER expose to client, no NEXT_PUBLIC_ prefix
# Generate a new keypair:
#   bun -e "const {Keypair}=require('@solana/web3.js');const bs58=require('bs58');const k=Keypair.generate();console.log('pubkey:',k.publicKey.toBase58());console.log('secret:',bs58.default.encode(k.secretKey))"
# Then airdrop SOL on devnet: https://faucet.solana.com
SPONSOR_PRIVATE_KEY=your_sponsor_wallet_private_key_base58_encoded
